{
  "name": "@solexllc/usx-contracts",
  "version": "0.1.1",
  "description": "Generated CMS contract manifest for USX components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solexconsulting/usx.git",
    "directory": "packages/usx-contracts"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
