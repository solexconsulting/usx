    "template": "input/input.django.html",
    "props": {
        "label": {
            "type": "string",
            "default": "Label"
        },
        "id": {
            "type": "string",
            "default": null
        },
        "placeholder": {
            "type": "string",
            "default": "Placeholder text"
        },
        "error": {
            "type": "string",
            "default": null
