{
  "name": "toggle",
  "template": "toggle/toggle.django.html",
  "version": 1,
  "required": [
    "options"
  ],
  "props": {
    "id": {
      "type": "string",
      "description": "ID for the control (used as prefix for option IDs)"
    },
    "options": {
      "type": "array",
      "description": "Array of option objects: {value,label,icon?,disabled?}",
      "items": {
        "type": "object",
        "description": "Toggle option.",
        "properties": {
          "value": {
            "type": "string",
            "description": "Option value."
          },
          "label": {
            "type": "string",
            "description": "Option display label."
          },
          "icon": {
            "type": "string",
            "description": "Optional icon name."
          },
          "disabled": {
            "type": "boolean",
            "description": "Disable this option."
          }
        }
      }
    },
    "value": {
      "type": "string",
      "description": "Controlled selected value"
    },
    "defaultValue": {
      "type": "string",
      "description": "Uncontrolled initial value"
    },
    "name": {
      "type": "string",
      "description": "Name attribute for radio inputs"
    },
    "variant": {
      "type": "select",
      "options": [
        "text",
        "icon"
      ],
      "description": "Visual variant"
    },
    "disabled": {
      "type": "boolean",
      "description": "Disable the whole control",
      "default": false
    },
    "className": {
      "type": "string",
      "description": "Additional classes"
    }
  }
}
