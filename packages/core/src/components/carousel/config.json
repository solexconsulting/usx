{
  "name": "carousel",
  "template": "carousel/carousel.django.html",
  "props": {
    "id": { "type": "string", "default": "carousel-1", "description": "Base id for slides and anchors" },
    "slides": { "type": "array", "description": "Array of slide objects {content: string|node}" },
    "ariaLabel": { "type": "string", "default": "Featured content", "description": "Aria label for the carousel region" },
    "showDots": { "type": "boolean", "default": true, "description": "Whether to render navigation dots" },
    "className": { "type": "string", "description": "Additional classes to add to the carousel" }
  }
}
