{
  "name": "@solexllc/usx-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./contracts": {
      "default": "./src/contracts.js"
    },
    "./contracts.json": "./dist/component-contracts.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/generate-contracts.js && vite build && node scripts/build-contracts.mjs"
  },
  "dependencies": {
    "@solexllc/usx": "workspace:*",
    "@solexllc/usx-theme": "workspace:*",
    "@solexllc/usx-uswds-fixes": "workspace:*",
    "classnames": "^2.5.1",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.98.0",
    "vite": "^6.4.1"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  }
}
