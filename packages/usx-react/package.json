    "@solexllc/usx-uswds-fixes": "workspace:*",
    "classnames": "^2.5.1",
    "prop-types": "^15.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.98.0",
    "vite": "^6.4.1"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  }
