{
  "name": "@solexllc/usx-react",
  "version": "0.6.0",
  "description": "React component library for USX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solexconsulting/usx.git",
    "directory": "packages/usx-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.cjs",
