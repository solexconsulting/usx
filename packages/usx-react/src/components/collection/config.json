{
  "name": "collection",
  "template": "collection/collection.django.html",
  "version": 2,
  "props": {
    "items": {
      "type": "array",
      "default": [],
      "description": "Collection items with optional calendarDateProps, meta, and tags.",
      "items": {
        "type": "object",
        "description": "Collection item.",
        "properties": {
          "href": {
            "type": "string",
            "description": "Item link URL."
          },
          "heading": {
            "type": "string",
            "description": "Item heading text."
          },
          "description": {
            "type": "string",
            "description": "Item description text."
          },
          "imgSrc": {
            "type": "string",
            "description": "Optional thumbnail image URL."
          },
          "imgAlt": {
            "type": "string",
            "description": "Alt text for the thumbnail image."
          },
          "meta": {
            "type": "array",
            "description": "Optional meta list: [{ text, datetime? }]."
          },
          "tags": {
            "type": "array",
            "description": "Optional tag list: [{ label, isNew? }]."
          },
          "calendarDateProps": {
            "type": "object",
            "component": "calendar-date",
            "description": "Props passed to the calendar-date component."
          }
        }
      }
    },
    "condensed": {
      "type": "boolean",
      "default": false,
      "description": "Applies usa-collection--condensed for a compact headings-only layout."
    },
    "className": {
      "type": "string",
      "default": "",
      "description": "Additional CSS classes for the collection wrapper."
    }
  }
}
