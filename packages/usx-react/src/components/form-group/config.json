{
  "name": "form-group",
  "template": "form-group/form-group.django.html",
  "version": 2,
  "default": {
    "children": "<div class=\"usa-form-group usx-form-group\"><label class=\"usa-label usx-label\" for=\"form-group-default-input\">Form group label</label><input id=\"form-group-default-input\" class=\"usa-input usx-input\" placeholder=\"Type here\"/></div>"
  },
  "props": {
    "children": {
      "type": "slot",
      "default": null,
      "description": "Inner HTML content of the form group."
    },
    "error": {
      "type": "boolean",
      "default": false,
      "description": "Applies the error modifier class to the form group wrapper."
    },
    "className": {
      "type": "string",
      "default": "",
      "description": "Additional CSS classes to apply to the form group wrapper."
    }
  }
}
