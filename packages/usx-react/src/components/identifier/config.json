{
  "name": "identifier",
  "template": "identifier/identifier.django.html",
  "version": 1,
  "default": {
    "domain": "domain.gov",
    "language": "en",
    "parentAgencies": [
      {
        "name": "<Parent agency>",
        "href": ""
      }
    ],
    "avatarProps": [
      {
        "href": "",
        "src": "./lady_liberty.png",
        "alt": "Statue of Liberty"
      }
    ],
    "requiredLinks": [
      {
        "href": "",
        "label": "About <Parent shortname>"
      },
      {
        "href": "",
        "label": "Accessibility statement"
      },
      {
        "href": "",
        "label": "FOIA requests"
      },
      {
        "href": "",
        "label": "No FEAR Act data"
      },
      {
        "href": "",
        "label": "Office of the Inspector General"
      },
      {
        "href": "",
        "label": "Performance reports"
      },
      {
        "href": "",
        "label": "Privacy policy"
      }
    ],
    "taxpayerDisclaimer": false,
    "overlapAvatars": false
  },
  "props": {
    "domain": {
      "type": "string",
      "description": "Agency domain displayed in the identifier."
    },
    "language": {
      "type": "select",
      "options": [
        "en",
        "es"
      ],
      "description": "Language for labels and helper text."
    },
    "parentAgencies": {
      "type": "array",
      "description": "Array of parent agency links used in the disclaimer.",
      "items": {
        "type": "object",
        "description": "Parent agency.",
        "properties": {
          "name": { "type": "string", "description": "Agency name." },
          "href": { "type": "string", "description": "Link to the agency's site." },
          "useThe": { "type": "boolean", "description": "Whether \"the\" precedes the name in the English disclaimer, e.g. \"the Department of...\". Default true. Has no effect on the Spanish disclaimer." }
        }
      }
    },
    "avatarProps": {
      "type": "array",
      "description": "Props for Avatar components rendered in the identifier masthead.",
      "items": {
        "type": "object",
        "description": "Avatar props, including image, initials, and icon variants.",
        "component": "avatar",
        "properties": {
          "shape": {
            "type": "select",
            "options": [null, "circle", "rounded-sm", "rounded-md", "rounded-lg", "rounded-xl"],
            "description": "Shape utility for the logo image, overriding logoShape for this item."
          }
        }
      }
    },
    "requiredLinks": {
      "type": "array",
      "description": "Array of required footer links.",
      "items": {
        "type": ["string", "object"],
        "description": "A link label string (uses the default href for that label), or a { href, label } object.",
        "properties": {
          "href": { "type": "string", "description": "Link URL." },
          "label": { "type": "string", "description": "Link text." }
        }
      }
    },
    "taxpayerDisclaimer": {
      "type": "boolean",
      "description": "Appends the taxpayer disclaimer sentence to the identity disclaimer."
    },
    "overlapAvatars": {
      "type": "boolean",
      "description": "Apply overlap styling to avatar logos."
    },
    "logoShape": {
      "type": "select",
      "options": [
        null,
        "circle",
        "rounded-sm",
        "rounded-md",
        "rounded-lg",
        "rounded-xl"
      ],
      "description": "Default shape applied to all logos. Per-logo shape field takes precedence."
    },
    "className": {
      "type": "string",
      "description": "Additional classes"
    }
  }
}
