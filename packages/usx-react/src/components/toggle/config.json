{
  "name": "toggle",
  "template": "toggle/toggle.django.html",
  "version": 2,
  "required": [
    "options"
  ],
  "props": {
    "id": {
      "type": "string",
      "description": "ID for the control (used as prefix for option IDs). Supply a unique ID in Django."
    },
    "options": {
      "type": "array",
      "description": "Options as strings, numbers, or objects with value, label, icon, and disabled. Django requires option objects with value and label. Use distinct values and a label for every icon option.",
      "items": {
        "type": [
          "object",
          "string",
          "number"
        ],
        "description": "Toggle option.",
        "properties": {
          "value": {
            "type": [
              "string",
              "number"
            ],
            "description": "Option value."
          },
          "label": {
            "type": "slot",
            "description": "Option display label."
          },
          "icon": {
            "type": "string",
            "description": "Optional icon name."
          },
          "disabled": {
            "type": "boolean",
            "description": "Disable this option."
          }
        }
      }
    },
    "value": {
      "type": [
        "string",
        "number"
      ],
      "description": "Controlled selected value"
    },
    "defaultValue": {
      "type": [
        "string",
        "number"
      ],
      "description": "Uncontrolled initial value"
    },
    "name": {
      "type": "string",
      "description": "Name attribute for radio inputs"
    },
    "variant": {
      "type": "select",
      "options": [
        "text",
        "icon"
      ],
      "description": "Visual variant",
      "default": "text"
    },
    "disabled": {
      "type": "boolean",
      "description": "Disable the whole control",
      "default": false
    },
    "className": {
      "type": "string",
      "description": "Additional classes for the toggle list"
    },
    "ariaLabel": {
      "type": "string",
      "description": "Accessible name for the radio group. Defaults to name when omitted."
    },
    "required": {
      "type": "boolean",
      "default": false,
      "description": "Require a choice for native form submission."
    },
    "onChange": {
      "type": "function",
      "description": "React callback receiving the selected string or number.",
      "renderers": {
        "django": {
          "supported": false
        }
      }
    }
  }
}
