{
  "name": "summary-box",
  "template": "summary-box/summary-box.django.html",
  "version": 2,
  "required": [
    "heading"
  ],
  "props": {
    "id": {
      "type": "string",
      "description": "Heading id used by aria-labelledby"
    },
    "heading": {
      "type": "string",
      "description": "Required summary heading"
    },
    "content": {
      "type": "slot",
      "description": "HTML/text summary content"
    },
    "children": {
      "type": "slot",
      "description": "Inner HTML or text (takes priority over content)"
    },
    "className": {
      "type": "string",
      "description": "Additional classes"
    }
  }
}
