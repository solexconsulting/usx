{
  "name": "tag-group",
  "template": "tag-group/tag-group.django.html",
  "version": 2,
  "default": {
    "tagProps": [
      {
        "value": "Primary",
        "color": "primary"
      },
      {
        "value": "Secondary",
        "color": "secondary"
      },
      {
        "value": "Accent Cool",
        "color": "accent-cool"
      },
      {
        "value": "Blue",
        "color": "blue"
      },
      {
        "value": "Base",
        "color": "base"
      }
    ]
  },
  "props": {
    "tagProps": {
      "type": "array",
      "description": "Array of tags rendered by the group.",
      "items": {
        "type": "object",
        "description": "Tag item.",
        "component": "tag"
      }
    },
    "children": {
      "type": "slot",
      "description": "Inner HTML or text"
    },
    "className": {
      "type": "string",
      "description": "Additional classes"
    }
  }
}
