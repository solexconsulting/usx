{
  "name": "button-group",
  "template": "button-group/button-group.django.html",
  "version": 1,
  "default": {
    "buttonProps": [
      {
        "label": "Map",
        "variant": "primary"
      },
      {
        "label": "Hybrid",
        "variant": "outline"
      },
      {
        "label": "Satellite",
        "variant": "outline"
      }
    ]
  },
  "props": {
    "buttonProps": {
      "type": "array",
      "description": "Array of buttons rendered by the group.",
      "items": {
        "type": "object",
        "description": "Button item.",
        "component": "button",
        "properties": {
          "itemClassName": {
            "type": "string",
            "description": "Additional CSS classes on the list item wrapping the button."
          }
        }
      }
    },
    "segmented": {
      "type": "boolean",
      "description": "Whether the button group is segmented",
      "default": false
    },
    "className": {
      "type": "string",
      "description": "Additional classes"
    }
  }
}
