{
  "name": "footer",
  "template": "footer/footer.django.html",
  "version": 2,
  "default": {
    "variant": "big",
    "navColumns": [
      {
        "heading": "Programs",
        "links": [
          {
            "text": "Benefits",
            "href": "/programs/benefits"
          },
          {
            "text": "Health Services",
            "href": "/programs/health"
          },
          {
            "text": "Education",
            "href": "/programs/education"
          },
          {
            "text": "Housing",
            "href": "/programs/housing"
          }
        ]
      },
      {
        "heading": "Resources",
        "links": [
          {
            "text": "Forms",
            "href": "/resources/forms"
          },
          {
            "text": "Publications",
            "href": "/resources/publications"
          },
          {
            "text": "Data & Research",
            "href": "/resources/data"
          },
          {
            "text": "Tools",
            "href": "/resources/tools"
          }
        ]
      },
      {
        "heading": "Connect",
        "links": [
          {
            "text": "Newsroom",
            "href": "/newsroom"
          },
          {
            "text": "Events",
            "href": "/events"
          },
          {
            "text": "Social Media",
            "href": "/social"
          },
          {
            "text": "Newsletter",
            "href": "/newsletter"
          }
        ]
      },
      {
        "heading": "About",
        "links": [
          {
            "text": "Mission",
            "href": "/about/mission"
          },
          {
            "text": "Leadership",
            "href": "/about/leadership"
          },
          {
            "text": "Careers",
            "href": "/about/careers"
          },
          {
            "text": "Contact Us",
            "href": "/contact"
          }
        ]
      }
    ],
    "signUp": {
      "heading": "Stay informed",
      "emailLabel": "Your email address",
      "emailId": "footer-email-big",
      "buttonText": "Subscribe"
    },
    "branding": {
      "logo": {
        "fallback": "symbol-only.svg",
        "sources": [
          {
            "media": "(min-width: 40em)",
            "srcSet": "linear-w-symbol_left.svg"
          }
        ]
      },
      "logoInverse": {
        "fallback": "white_symbol-only.png",
        "sources": [
          {
            "media": "(min-width: 40em)",
            "srcSet": "white_linear-w-symbol_left.png"
          }
        ]
      },
      "title": "Agency Name"
    },
    "brandingUrl": "/",
    "socialLinks": [
      {
        "icon": "img/usa-icons/facebook.svg",
        "href": "/social/facebook",
        "alt": "Facebook"
      },
      {
        "icon": "img/usa-icons/twitter.svg",
        "href": "/social/twitter",
        "alt": "Twitter"
      },
      {
        "icon": "img/usa-icons/youtube.svg",
        "href": "/social/youtube",
        "alt": "YouTube"
      },
      {
        "icon": "img/usa-icons/instagram.svg",
        "href": "/social/instagram",
        "alt": "Instagram"
      },
      {
        "icon": "img/usa-icons/rss_feed.svg",
        "href": "/social/rss",
        "alt": "RSS"
      }
    ],
    "contactHeading": "Agency Contact Center",
    "contactPhone": {
      "href": "tel:1-800-555-5555",
      "text": "(800) 555-GOVT"
    },
    "contactEmail": {
      "href": "mailto:info@agency.gov",
      "text": "info@agency.gov"
    }
  },
  "props": {
    "staticBaseUrl": {
      "type": "string",
      "description": "Optional branding and social-image asset base, overriding window.usxBaseUrl in React or STATIC_URL in Django. Defaults to the global base or /."
    },
    "variant": {
      "type": "select",
      "options": [
        "big",
        "medium",
        "slim"
      ],
      "default": "medium",
      "description": "Footer layout variant. 'big' includes collapsible nav columns and an optional sign-up form. 'medium' shows flat primary links. 'slim' puts contact info in the primary bar."
    },
    "returnToTop": {
      "type": "boolean",
      "default": true,
      "description": "Show the 'Return to top' link. Set false to hide."
    },
    "returnToTopLabel": {
      "type": "string",
      "default": "Return to top",
      "description": "Label for the return-to-top link."
    },
    "returnToTopHref": {
      "type": "string",
      "default": "#",
      "description": "Anchor href for the return-to-top link."
    },
    "navColumns": {
      "type": "object",
      "description": "(big variant) Array of nav column objects: [{ heading, links: [{ text, href, ariaLabel? }] }]"
    },
    "navLinks": {
      "type": "object",
      "description": "(medium/slim variants) Array of primary nav links: [{ text, href, ariaLabel? }]"
    },
    "navAriaLabel": {
      "type": "string",
      "default": "Footer navigation",
      "description": "Accessible aria-label for the footer nav element."
    },
    "signUp": {
      "type": "object",
      "description": "(big variant, optional) Email sign-up config: { heading?, emailLabel?, emailId?, buttonText?, action? }"
    },
    "branding": {
      "type": "object",
      "description": "Branding config (same shape as Header branding): { title?, symbol?, logo?, alt? }. Use 'symbol' + 'title' to show a decorative image beside agency name text. Use 'logo' for a full standalone logo image (title used as alt text). Add 'symbolInverse'/'logoInverse' to supply dark-shell artwork the theme swaps to."
    },
    "brandingUrl": {
      "type": "string",
      "default": "/",
      "description": "URL for the branding link (wraps the logo/symbol image and title)."
    },
    "socialLinks": {
      "type": "object",
      "description": "Array of social icon links: [{ icon (img src), href, alt }]"
    },
    "contactHeading": {
      "type": "string",
      "description": "Heading label above the contact info block."
    },
    "contactPhone": {
      "type": "object",
      "description": "Phone contact. Object: { href, text } — or a plain string (auto-prefixed with tel:)."
    },
    "contactEmail": {
      "type": "object",
      "description": "Email contact. Object: { href, text } — or a plain string (auto-prefixed with mailto:)."
    },
    "contactLinks": {
      "type": "object",
      "description": "Additional contact links: [{ href, text }]"
    },
    "className": {
      "type": "string",
      "default": "",
      "description": "Additional CSS classes applied to the root footer element."
    },
    "primaryChildren": {
      "type": "slot",
      "description": "Content for the primary section, replacing the variant's default navigation and sign-up content."
    },
    "secondaryChildren": {
      "type": "slot",
      "description": "Content for the secondary section, replacing the default branding and contact content."
    }
  }
}
