{
  "name": "task-list",
  "template": "task-list/task-list.django.html",
  "version": 1,
  "required": [
    "tasks"
  ],
  "default": {
    "tasks": [
      {
        "name": "Task 1",
        "href": "#",
        "tagProps": {
          "value": "Completed",
          "color": "success-light",
          "outline": false,
          "icon": "check"
        }
      },
      {
        "name": "Task 2",
        "href": "#",
        "tagProps": {
          "value": "In progress",
          "color": "primary-light",
          "outline": false
        }
      },
      {
        "name": "Task 3",
        "href": "#",
        "tagProps": {
          "value": "Not started",
          "color": "primary-lightest",
          "outline": false
        },
        "hint": "Due tomorrow"
      }
    ]
  },
  "props": {
    "tasks": {
      "type": "array",
      "description": "Array of task objects.",
      "items": {
        "type": "object",
        "description": "Task item.",
        "properties": {
          "name": {
            "type": "string",
            "description": "Task name/label."
          },
          "href": {
            "type": "string",
            "description": "Link URL for the task."
          },
          "hint": {
            "type": "string",
            "description": "Optional helper text shown below the task name."
          },
          "tagProps": {
            "type": "object",
            "description": "Optional status tag displayed alongside the task.",
            "component": "tag"
          }
        }
      }
    },
    "className": {
      "type": "string",
      "description": "Additional classes applied to the root ul element."
    }
  }
}
