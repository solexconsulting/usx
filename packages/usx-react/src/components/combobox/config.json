  "props": {
    "extraAttributes": {
      "type": "object",
      "description": "Additional attributes on the USWDS enhancement target."
    },
    "id": {
      "type": "string",
      "description": "id attribute for the select"
    },
    "name": {
      "type": "string",
      "description": "name attribute for the select"
    },
    "label": {
      "type": "slot",
      "description": "Label text for the combobox"
    },
    "disabled": {
      "type": "boolean",
      "description": "Disable the select",
      "default": false
    },
    "required": {
      "type": "boolean",
      "description": "Make the select required",
      "default": false
    },
    "hint": {
      "type": "slot",
      "description": "Hint text (renders aria-describedby)"
    },
    "placeholder": {
      "type": "string",
      "description": "Data-placeholder on the wrapper"
    },
    "defaultValue": {
      "type": "string",
      "description": "Default selected value"
    },
    "value": {
      "type": "string",
      "default": null,
      "description": "Option used to initialize the USWDS combo box, taking precedence over defaultValue."
    },
    "error": {
      "type": "slot",
      "description": "Error message (renders aria-describedby and error class)"
    },
    "options": {
      "type": "array",
      "description": "Array of { value, label } option objects",
      "items": {
        "type": "object",
        "description": "Selectable option.",
        "properties": {
          "value": {
            "type": "string",
            "description": "Option value."
          },
          "label": {
            "type": "string",
            "description": "Option display label."
          }
        }
      }
    },
    "onSearch": {
      "type": "function",
      "description": "Called on every keystroke in the text input; receives (value: string). Django consumers attach an input listener to the USWDS-enhanced control."
    },
    "onSelect": {
      "type": "function",
      "description": "Called when an option is selected or cleared; receives (value: string, option: object|null). Django consumers attach a change listener to the select."
    },
    "formGroup": {
      "type": "boolean",
      "default": true,
      "description": "Whether to wrap the label/hint/error/control in a `.usa-form-group`. Set to `false` when composing inside another form group."
    },
    "className": {
      "type": "string",
      "description": "Additional classes"
    }
  }
}
