{
  "name": "sidenav",
  "template": "sidenav/sidenav.django.html",
  "version": 1,
  "required": [
    "items"
  ],
  "props": {
    "items": {
      "type": "array",
      "description": "Array of navigation items: [{ text, href, current?, children?: [{ text, href, current?, children? }] }]",
      "items": {
        "type": "object",
        "description": "Navigation item.",
        "properties": {
          "text": {
            "type": "string",
            "description": "Link text."
          },
          "href": {
            "type": "string",
            "description": "Link URL."
          },
          "current": {
            "type": "boolean",
            "description": "Marks the active item."
          },
          "children": {
            "type": "array",
            "description": "Nested sub-items (same shape)."
          }
        }
      }
    },
    "ariaLabel": {
      "type": "string",
      "default": "Side navigation",
      "description": "Accessible aria-label for the nav element."
    },
    "className": {
      "type": "string",
      "description": "Additional CSS classes. Use responsive utilities like 'display-none tablet:display-block' to hide/show at breakpoints."
    }
  }
}
