{
  "name": "villain",
  "template": "villain/villain.django.html",
  "version": 1,
  "required": [
    "title"
  ],
  "props": {
    "title": {
      "type": "string",
      "description": "The main heading text"
    },
    "callout": {
      "type": "string",
      "description": "Optional alternate heading span displayed above the main title"
    },
    "paragraph": {
      "type": "string",
      "description": "Optional body paragraph text"
    },
    "button": {
      "type": "object",
      "description": "Optional call-to-action button",
      "properties": {
        "href": {
          "type": "string",
          "description": "Button link URL"
        },
        "text": {
          "type": "string",
          "description": "Button label text"
        }
      }
    },
    "ariaLabel": {
      "type": "string",
      "description": "Accessible label for the section element (defaults to 'Introduction')"
    },
    "className": {
      "type": "string",
      "description": "Additional CSS classes"
    }
  }
}
