{
  "name": "icon-list",
  "template": "icon-list/icon-list.django.html",
  "version": 1,
  "default": {
    "items": [
      {
        "iconName": "check_circle",
        "iconColor": "green",
        "content": "Wash your hands for 20 seconds with soap"
      },
      {
        "iconName": "check_circle",
        "iconColor": "green",
        "content": "Stay six feet away from others"
      },
      {
        "iconName": "cancel",
        "iconColor": "red",
        "content": "Avoid large gatherings"
      }
    ]
  },
  "props": {
    "items": {
      "type": "array",
      "description": "Array of icon list items.",
      "items": {
        "type": "object",
        "description": "Icon list item.",
        "properties": {
          "iconName": {
            "type": "string",
            "description": "Name of the icon to display, from the USWDS sprite (passed as the icon's name prop)."
          },
          "iconColor": {
            "type": "string",
            "description": "Color of the icon (passed as the icon's color prop)."
          },
          "iconSize": {
            "type": "number",
            "description": "Size of the icon (passed as the icon's size prop)."
          },
          "iconClassName": {
            "type": "string",
            "description": "Additional classes for the icon."
          },
          "title": {
            "type": "string",
            "description": "Optional heading text for the item."
          },
          "content": {
            "type": ["string", "slot"],
            "description": "Item text or rich content."
          },
          "itemClassName": {
            "type": "string",
            "description": "Additional classes for the list item element."
          },
          "contentClassName": {
            "type": "string",
            "description": "Additional classes for the item's content container."
          }
        }
      }
    },
    "primary": {
      "type": "boolean",
      "default": false,
      "description": "Adds the usa-icon-list--primary modifier."
    },
    "size": {
      "type": "select",
      "options": [
        null,
        "lg"
      ],
      "default": null,
      "description": "Optional list size modifier. Use lg for usa-icon-list--size-lg."
    },
    "className": {
      "type": "string",
      "description": "Additional classes"
    }
  }
}
