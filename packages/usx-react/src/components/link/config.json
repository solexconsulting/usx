{
  "name": "link",
  "template": "link/link.django.html",
  "version": 1,
  "required": [
    "href",
    "children"
  ],
  "props": {
    "href": {
      "type": "string",
      "description": "Link destination URL."
    },
    "children": {
      "type": "string",
      "description": "Inner link text or HTML."
    },
    "visited": {
      "type": "boolean",
      "description": "Apply visited styling class."
    },
    "external": {
      "type": "boolean",
      "description": "Apply external-link styling and default rel=noreferrer."
    },
    "alt": {
      "type": "boolean",
      "description": "Use alternate link style for dark backgrounds."
    },
    "newTab": {
      "type": "boolean",
      "description": "Open link in a new tab (target=_blank)."
    },
    "className": {
      "type": "string",
      "description": "Additional classes."
    }
  }
}
