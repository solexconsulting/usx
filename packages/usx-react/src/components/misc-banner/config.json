{
  "name": "misc-banner",
  "template": "misc-banner/misc-banner.django.html",
  "version": 4,
  "default": {
    "id": "misc-banner-misc",
    "color": "base",
    "badgeText": "misc",
    "message": "This is a miscellaneous banner.",
    "casualLinkText": "Casual Link",
    "casualLinkHref": "https://usx.solex.studio/",
    "importantLinkText": "Important Link",
    "importantLinkHref": "https://usx.solex.studio/",
    "importantLinkIcon": "arrow_forward",
    "showLearnMore": true,
    "showReturnLink": true
  },
  "props": {
    "id": {
      "type": "string",
      "description": "Id for the banner's root element. The dropdown toggle and menu ids derive from it as `<id>-dropdown-toggle` and `<id>-dropdown`. React generates one when omitted."
    },
    "children": {
      "type": "slot",
      "description": "Advanced override for custom inner markup"
    },
    "className": {
      "type": "string",
      "description": "Additional classes for the root banner"
    },
    "color": {
      "type": "string",
      "default": "beta",
      "description": "Color utility name for the banner background and optional badge text; accepts any string"
    },
    "badgeText": {
      "type": "string",
      "description": "Badge label text; omit or pass an empty string to hide the badge"
    },
    "message": {
      "type": "string",
      "description": "Main banner message"
    },
    "casualLinkText": {
      "type": "string",
      "description": "Learn more link text"
    },
    "casualLinkHref": {
      "type": "string",
      "description": "Learn more link destination"
    },
    "showLearnMore": {
      "type": "boolean",
      "description": "Show learn more link",
      "default": false
    },
    "importantLinkText": {
      "type": "string",
      "description": "Secondary return link text"
    },
    "importantLinkHref": {
      "type": "string",
      "description": "Secondary return link destination"
    },
    "importantLinkIcon": {
      "type": "string",
      "description": "Icon name used before return text"
    },
    "showReturnLink": {
      "type": "boolean",
      "description": "Show return link section",
      "default": false
    }
  }
}
