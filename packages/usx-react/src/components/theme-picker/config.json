{
  "name": "theme-picker",
  "template": "theme-picker/theme-picker.django.html",
  "version": 6,
  "required": ["themes"],
  "default": {
    "id": "theme-picker-1",
    "label": "Theme",
    "themes": [
      {
        "value": "default",
        "label": "Default"
      },
      {
        "value": "forest",
        "label": "Forest"
      },
      {
        "value": "sunset",
        "label": "Sunset"
      },
      {
        "value": "ocean",
        "label": "Ocean"
      },
      {
        "value": "aurora",
        "label": "Aurora"
      },
      {
        "value": "borealis",
        "label": "Borealis"
      },
      {
        "value": "midnight",
        "label": "Midnight"
      },
      {
        "value": "carbon",
        "label": "Carbon"
      },
      {
        "value": "vads",
        "label": "VADS"
      },
      {
        "value": "gov-uk",
        "label": "GOV.UK"
      },
      {
        "value": "nasa",
        "label": "NASA"
      }
    ],
    "defaultValue": "default"
  },
  "props": {
    "id": {
      "type": "string",
      "description": "Element id for the value field"
    },
    "name": {
      "type": "string",
      "description": "Form field name"
    },
    "label": {
      "type": "string",
      "default": "Theme",
      "description": "Accessible picker label"
    },
    "themes": {
      "type": "array",
      "description": "Theme choices with a label and a value written verbatim to <html data-usx-theme>."
    },
    "defaultValue": {
      "type": "string",
      "description": "Initial theme value when value is omitted"
    },
    "value": {
      "type": "string",
      "default": null,
      "description": "Initial selected theme. Takes precedence over defaultValue."
    },
    "className": {
      "type": "string",
      "description": "Additional CSS classes"
    },
    "extraAttributes": {
      "type": "object",
      "description": "Additional HTML attributes on the theme picker root."
    },
    "variant": {
      "type": "select",
      "options": ["default", "popover", "swap"],
      "default": "default",
      "description": "Picker presentation: default, popover, or swap. All variants stay hidden until enhanced. ThemePicker enhancement applies the selected theme and connects Swap's button behavior. Swap uses two themes."
    },
    "popoverAlign": {
      "type": "select",
      "options": ["start", "center", "end"],
      "default": "start",
      "description": "Alignment of the popover panel relative to its trigger. Only used by the popover variant."
    }
  }
}
