{
  "name": "theme-picker",
  "template": "theme-picker/theme-picker.django.html",
  "version": 1,
  "required": [
    "themes"
  ],
  "default": {
    "id": "theme-picker-1",
    "label": "Theme",
    "themes": [
      {
        "value": "Default",
        "label": "Default"
      },
      {
        "value": "Forest",
        "label": "Forest"
      },
      {
        "value": "Sunset",
        "label": "Sunset"
      },
      {
        "value": "Ocean",
        "label": "Ocean"
      },
      {
        "value": "Aurora",
        "label": "Aurora"
      },
      {
        "value": "Borealis",
        "label": "Borealis"
      },
      {
        "value": "Midnight",
        "label": "Midnight"
      },
      {
        "value": "Carbon",
        "label": "Carbon"
      },
      {
        "value": "VADS",
        "label": "VADS"
      },
      {
        "value": "GOV.UK",
        "label": "GOV.UK"
      },
      {
        "value": "NASA",
        "label": "NASA"
      }
    ],
    "defaultValue": "Default"
  },
  "props": {
    "id": {
      "type": "string",
      "description": "Element id for the select"
    },
    "name": {
      "type": "string",
      "description": "Form field name"
    },
    "label": {
      "type": "string",
      "default": "Theme",
      "description": "Label displayed above the select"
    },
    "themes": {
      "type": "array",
      "description": "Array of { value, label } theme options."
    },
    "defaultValue": {
      "type": "string",
      "description": "Initial selected value for uncontrolled usage"
    },
    "onChange": {
      "type": "function",
      "description": "React callback for a selected theme. Django consumers can listen for the select's native change event; applying the theme remains the application's responsibility.",
      "renderers": { "django": { "supported": false } }
    },
    "className": {
      "type": "string",
      "description": "Additional CSS classes"
    }
  }
}
