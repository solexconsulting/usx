{
  "name": "@solexllc/usx",
  "version": "0.1.6",
  "description": "Compiled USWDS-based component styles for USX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solexconsulting/usx.git",
    "directory": "packages/usx"
  },
  "publishConfig": {
    "access": "public"
  },
  "sass": "src/index.scss",
  "exports": {
    ".": {
      "sass": "./src/index.scss"
    },
    "./themed": {
      "sass": "./src/themed.scss"
    },
    "./utilities": {
      "sass": "./src/_utilities.scss"
    },
    "./typography": {
      "sass": "./src/components/_typography.scss"
    },
    "./img/usx-sprite.svg": "./src/img/usx-sprite.svg",
    "./img/usx-icons.json": "./src/img/usx-icons.json"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@solexllc/usx-theme": "workspace:*"
  },
  "scripts": {
    "build": "node scripts/build-sprite.mjs",
    "dev": "node scripts/build-sprite.mjs --watch",
    "test": "node test/theme-check.mjs"
  },
  "devDependencies": {
    "sass": "^1.98.0"
  }
}