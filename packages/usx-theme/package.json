{
  "name": "@solexllc/usx-theme",
  "version": "0.2.0",
  "description": "Design tokens package for USX.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/solexconsulting/usx.git",
    "directory": "packages/usx-theme"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/tokens.js",
  "style": "dist/tokens.css",
  "exports": {
    ".": {
      "sass": "./src/tokens.scss",
      "style": "./dist/tokens.css",
      "default": "./dist/tokens.js"
    },
    "./variables": {
      "sass": "./src/_variables.scss"
    },
    "./hooks": {
      "sass": "./dist/_hooks.scss"
    },
    "./themes": {
      "sass": "./src/_themes.scss"
    },
    "./themes.css": "./dist/themes.css",
    "./themes/*.css": "./dist/themes/*.css",
    "./theme.css": "./dist/theme.css",
    "./theme-manifest": {
      "default": "./src/theme-manifest.js"
    },
    "./theme-manifest.json": "./dist/theme-manifest.json",
    "./derive": {
      "default": "./src/derive.js"
    },
    "./presets": {
      "default": "./src/presets.js"
    },
    "./system-colors": {
      "default": "./src/system-colors.generated.js"
    },
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "src",
    "build.js"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "test": "node build.js && node test/themes-check.mjs",
    "generate:system-colors": "node scripts/generate-system-colors.js"
  },
  "devDependencies": {
    "sass": "^1.98.0"
  }
}
