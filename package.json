{
  "name": "agency-ui-platform",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "build:storybook:all": "pnpm --filter @agency-ui-platform/storybook --filter @agency-ui-platform/storybook-react --filter @agency-ui-platform/storybook-html --filter @agency-ui-platform/storybook-js --filter @agency-ui-platform/storybook-django run build",
    "dev": "pnpm -r --parallel dev",
    "dev:storybook:all": "pnpm dev:storybook:remotes & sleep 4 && pnpm dev:storybook:host",
    "dev:storybook:host": "pnpm --filter @agency-ui-platform/storybook run dev",
    "dev:storybook:remotes": "pnpm --parallel --filter @agency-ui-platform/storybook-react --filter @agency-ui-platform/storybook-html --filter @agency-ui-platform/storybook-js --filter @agency-ui-platform/storybook-django run dev",
    "dev:storybook:start": "pnpm dev:storybook:remotes && sleep 4 && pnpm dev:storybook:host",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "tokens:build": "pnpm --filter @agency-ui-platform/tokens run build"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/html": "^8.6.18",
    "@storybook/react": "8.6.18",
    "@storybook/react-vite": "8.6.18",
    "@uswds/uswds": "^3.13.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.98.0",
    "storybook": "8.6.18"
  }
}
