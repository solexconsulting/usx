{
  "name": "usx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "storybook:build": "pnpm --filter @solexllc/storybook run build",
    "test": "node scripts/validate-configs.js && pnpm -r test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-path .gitignore && stylelint '**/*.{css,scss}' --ignore-path .gitignore",
    "format": "prettier --write .",
    "new-component": "node scripts/new-component.js",
    "generate:exports": "node scripts/generate-exports.js",
    "generate:contracts": "node scripts/generate-contracts.js",
    "validate:configs": "node scripts/validate-configs.js"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/html": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@uswds/uswds": "^3.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "10.3.6",
    "prettier": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.98.0",
    "storybook": "^10.3.6",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  }
}