{
  "name": "agency-ui-platform",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "storybook": "pnpm --filter @agency-ui-platform/storybook run dev",
    "storybook:build": "pnpm --filter @agency-ui-platform/storybook run build",
    "dev": "pnpm -r --parallel dev",
    "new-component": "node scripts/new-component.js",
    "generate-exports": "node scripts/generate-exports.cjs",
    "validate:configs": "node scripts/validate-configs.js",
    "lint": "eslint '**/*.{js,jsx}' --ignore-pattern '**/node_modules/**' --ignore-pattern '**/venv/**' --ignore-pattern '**/storybook-static/**' && stylelint '**/*.{css,scss}' --ignore-path .gitignore --ignore-pattern '**/venv/**'",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "tokens:build": "pnpm --filter @agency-ui-platform/tokens run build"
  },
  "devDependencies": {
    "@uswds/uswds": "^3.13.0",
    "@storybook/html": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.98.0",
    "storybook": "^10.3.6",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "prettier": "^3.8.1",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "eslint-plugin-storybook": "10.3.6"
  },
  "dependencies": {
    "ajv": "^8.12.0"
  }
}