# Copy to deploy/.env and fill in real values. Never commit deploy/.env.

# Registry/tag for the built images.
REGISTRY=localhost:5000
TAG=latest

# URL the *browser* uses to reach Django — must be a LAN IP/hostname
# reachable from the browser, not the "storybook-django" Docker service name.
USX_DJANGO_URL=http://<your-host-ip>:9090

# Django settings.
DJANGO_SECRET_KEY=<generate-a-random-value>
DJANGO_ALLOWED_HOSTS=<your-host-ip>,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://<your-host-ip>:6006,http://localhost:6006

# Only needed behind a reverse proxy that mounts either app under a subpath.
# DJANGO_FORCE_SCRIPT_NAME=/storybook-django
# DJANGO_STATIC_URL=/storybook/
